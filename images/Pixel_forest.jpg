<script>
var scrollLockY = 0;

function lockScroll() {
    scrollLockY = window.scrollY || window.pageYOffset;
    document.body.style.top = -scrollLockY + 'px';
    document.documentElement.classList.add('menu-open');
}

function unlockScroll() {
    document.documentElement.classList.remove('menu-open');
    document.body.style.top = '';
    window.scrollTo(0, scrollLockY);
}

function openMobileNav() {
    document.getElementById('menu-overlay').style.display = 'block';
    document.getElementById('mobile-menu-main-wrapper').style.display = 'block';
    lockScroll();
}

function openMobileSearch() {
    document.getElementById('menu-overlay').style.display = 'block';
    document.getElementById('mobile-search-main-wrapper').style.display = 'flex';
    lockScroll();
}

function closeMobileNav() {
    document.getElementById('menu-overlay').style.display = 'none';
    document.getElementById('mobile-menu-main-wrapper').style.display = 'none';
    document.getElementById('mobile-search-main-wrapper').style.display = 'none';
    unlockScroll();
}

document.getElementById('menu-overlay').addEventListener('click', closeMobileNav);
document.querySelector('a#mobile-menu-close').addEventListener('click', closeMobileNav);
document.querySelector('svg#search-main-container-close-icon').addEventListener('click', closeMobileNav);
</script>
