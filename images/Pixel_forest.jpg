		<i class="social-sharing-widget fab fa-twitter-square"></i>



	</a>



	</div></div>



	<div class="col-xs-2"><div class="box">



	<!-- Sharingbutton Pinterest -->



	<a href="https://pinterest.com/pin/create/button/?url=https://www.itsliquid.com/pipilotti-rist-pixel-forest-and-worry-will-vanish.html&amp;media=https://www.itsliquid.com/pipilotti-rist-pixel-forest-and-worry-will-vanish.html&amp;description=Pipilotti Rist: Pixel Forest and Worry Will Vanish" target="_blank" rel="noopener" aria-label="">



		<i class="social-sharing-widget fab fa-pinterest-square"></i>



	</a>



	</div></div>



	<div class="col-xs-2 social-share-whatsapp"><div class="box">



