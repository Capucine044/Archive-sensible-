	      <script>
  document.addEventListener( 'wpcf7mailsent', function( event ) {
    document.querySelectorAll("form.wpcf7-form > :not(.wpcf7-response-output)").forEach(el => {
      el.style.display = 'none';
    });
  }, false );
</script>


<script>
jQuery(document).ready(function ($) {

    // Carica la topbar via AJAX (bypassa la cache di SiteGround)
    $.post('https://www.itsliquid.com/wp-admin/admin-ajax.php', { action: 'get_topbar' }, function ( response ) {
        if ( ! response.success ) return;

        var data    = response.data;
        var banner  = $('#itsliquid-top-banner');
        var desktop = $('#itsliquid-top-banner-container');
        var mobile  = $('#itsliquid-top-banner-container-mobile');

        if ( ! data.text ) return;

        desktop.html( data.text );

        if ( data.text_mobile ) {
            mobile.html( data.text_mobile );
        }

        banner.css( 'display', '' );
    });

    // Scroll behavior
    var banner       = $('#itsliquid-top-banner');
    var triggerScroll = 100;

    $(window).on('scroll', function () {
        if ( $(this).scrollTop() > triggerScroll ) {
            banner.addClass('is-visible');
        } else {
            banner.removeClass('is-visible');
        }
    });

});
</script>



</body>
</html>