<script>
function openNav() {
  document.getElementById("overlay-nav").style.width = "100%";
}

function closeNav() {
  document.getElementById("overlay-nav").style.width = "0%";
}
</script>
<script>
function openSearch() {
    document.getElementById("overlay-search").style.left = "0";
